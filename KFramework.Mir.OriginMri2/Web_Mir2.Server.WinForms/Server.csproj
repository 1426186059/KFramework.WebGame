<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Mir2Server.WinForms</AssemblyName>
    <RootNamespace>Server.MirForms</RootNamespace>
    <!-- 高仿/协议类型有意覆盖框架同名类型（去系统依赖），抑制其刷屏警告；WinForms 设计器相关警告也抑制 -->
    <NoWarn>$(NoWarn);CS0436;1701;1702;WFO1000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 直接引用咱们已移植 WebSocket 的服务器工程（Envir/网络/数据模型都在里面），复用 WebSocket 传输 -->
    <ProjectReference Include="..\Web_Mir2.Server\Web_Mir2.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CustomFormControl">
      <HintPath>Components\CustomFormControl.dll</HintPath>
    </Reference>
    <Reference Include="Microsoft.VisualBasic.PowerPacks.Vs">
      <HintPath>Components\Microsoft.VisualBasic.PowerPacks.Vs.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Localization\Chinese.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="Localization\English.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="log4net.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>

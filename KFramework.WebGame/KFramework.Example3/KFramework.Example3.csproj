<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 内容包里的 JSON（图集 manifest）在运行时用反射反序列化 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>full</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <!-- 关卡文本改为通过 HTTP 远程下载（与内容包同一链路），因此发布到 wwwroot 供浏览器访问，不再内嵌进程序集 -->

  <ItemGroup>
    <ProjectReference Include="..\KFramework.MonoGame\KFramework.MonoGame.csproj" />
    <ProjectReference Include="..\KFramework.MonoGameExtend\KFramework.MonoGameExtend.csproj" />
  </ItemGroup>

  <!-- 引擎的浏览器层（KFramework/tsengine）目前由 tsconfig 固定输出到 MirGame/wwwroot/jsengine。 -->
  <!-- 编译引擎的浏览器层（TypeScript）。tsc 报错即中断构建，不留旧产物。 -->
  <Target Name="BuildTypeScript" BeforeTargets="BeforeBuild" Condition="Exists('$(MSBuildThisFileDirectory)..\KFramework.MonoGame\tsengine\node_modules')">
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)..\KFramework.MonoGame\tsengine" />
  </Target>

  <Target Name="SyncJsEngine" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_EngineJs Include="$(MSBuildThisFileDirectory)..\KFramework.MonoGame\tsengine\dist\**\*.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_EngineJs)" DestinationFiles="@(_EngineJs->'$(MSBuildThisFileDirectory)wwwroot\jsengine\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- 本工程独占的内容管线：Content/raw -> Content/content -> wwwroot/content -->
  <Target Name="BuildGameContent" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\KFramework.Content.Cli\KFramework.Content.Cli.csproj&quot; -v q --nologo -- --root &quot;$(MSBuildThisFileDirectory)Content&quot;" ContinueOnError="true" />
    <!-- 清理旧格式（.pak / manifest.json）与旧哈希的 .web.lib，避免与新版内容混淆 -->
    <ItemGroup>
      <WebLibStale Include="$(MSBuildThisFileDirectory)wwwroot\content\*.pak" />
      <WebLibStale Include="$(MSBuildThisFileDirectory)wwwroot\content\manifest.json" />
      <WebLibStale Include="$(MSBuildThisFileDirectory)wwwroot\content\*.web.lib" />
      <WebLibStale Include="$(MSBuildThisFileDirectory)wwwroot\content\version.manifest" />
    </ItemGroup>
    <Delete Files="@(WebLibStale)" Condition="'@(WebLibStale)' != ''" ContinueOnError="true" />
    <ItemGroup>
      <_PublishedContent Include="$(MSBuildThisFileDirectory)Content\content\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishedContent)" DestinationFiles="@(_PublishedContent->'$(MSBuildThisFileDirectory)wwwroot\content\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>

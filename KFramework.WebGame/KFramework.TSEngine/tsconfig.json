{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,

    "rootDir": "./src",
    // 产物输出到 dist/jsengine/，并由 build.mjs 把 deps 一并拷入，
    // 形成“开箱即用”的完整引擎目录，供各示例的 SyncJsEngine 整文件夹复制。
    "outDir": "./dist/jsengine",

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "newLine": "lf"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}

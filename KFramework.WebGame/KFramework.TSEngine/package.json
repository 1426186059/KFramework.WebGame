{
  "name": "kframework-tsengine",
  "version": "1.0.0",
  "private": true,
  "description": "KFramework 浏览器引擎的 TypeScript 源码。编译产物输出到 dist/jsengine（含依赖），供各示例直接复制到 wwwroot/jsengine。",
  "scripts": {
    "build": "tsc && node copy_deps.mjs",
    "watch": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "typescript": "^5.9.2"
  }
}

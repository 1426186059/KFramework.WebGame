<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MirGame</RootNamespace>
    <StartupObject>MirGame.Program</StartupObject>
    <!-- 内容包里的 JSON（manifest / 游戏配置）在运行时用反射反序列化 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
    <WasmLoadAllGlobalizationData>false</WasmLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KFramework.MonoGame\KFramework.MonoGame.csproj" />
  </ItemGroup>

  <!-- 引擎的浏览器层用 TypeScript 编写（KFramework/tsengine），
       tsc 的产物直接输出到 wwwroot/jsengine（见 tsengine/tsconfig.json 的 outDir）。
       装了 node 时这里顺手编译一次；没装 node 则使用仓库中已提交的产物。 -->
  <!-- 编译引擎的浏览器层（TypeScript）。
       注意：不带 ContinueOnError —— tsc 报错必须让整个构建失败，
       否则会用 tsengine/bin 里的旧产物继续跑，问题极难排查。 -->
  <Target Name="BuildTypeScript" BeforeTargets="BeforeBuild"
          Condition="Exists('$(MSBuildThisFileDirectory)..\KFramework.MonoGame\tsengine\node_modules')">
    <Exec Command="npm run build"
          WorkingDirectory="$(MSBuildThisFileDirectory)..\KFramework.MonoGame\tsengine" />
  </Target>

  <!-- tsc 产物统一在 KFramework.MonoGame/tsengine/bin，复制到本工程 wwwroot/jsengine。
       挂在 BuildTypeScript 之后，保证先编译再复制。 -->
  <Target Name="SyncJsEngine" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_EngineJs Include="$(MSBuildThisFileDirectory)..\KFramework.MonoGame\tsengine\dist\**\*.js" />
    </ItemGroup>
    <Copy SourceFiles="@(_EngineJs)"
          DestinationFiles="@(_EngineJs->'$(MSBuildThisFileDirectory)wwwroot\jsengine\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- 1. 运行内容管线：KFramework.Content/raw -> KFramework.Content/content
       2. 把发布后的 content 同步到 wwwroot/content 供浏览器 HTTP 访问 -->
  <Target Name="BuildGameContent" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\KFramework.Content.Cli\KFramework.Content.Cli.csproj&quot; -v q --nologo -- --root &quot;$(MSBuildThisFileDirectory)Content&quot;" />
    <ItemGroup>
      <_PublishedContent Include="$(MSBuildThisFileDirectory)..\KFramework.Content\content\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishedContent)"
          DestinationFiles="@(_PublishedContent->'$(MSBuildThisFileDirectory)wwwroot\content\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>

<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>KFramework.Example.Tank</RootNamespace>
    <AssemblyName>KFramework.Example.Tank</AssemblyName>
    <StartupObject>KFramework.Example.Tank.Program</StartupObject>
    <!-- 内容包里的 JSON（manifest / 关卡）在运行时用反射反序列化 -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>false</InvariantGlobalization>
    <WasmLoadAllGlobalizationData>false</WasmLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="*.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KFramework.MonoGame\KFramework.MonoGame.csproj" />
    <ProjectReference Include="..\KFramework.MonoGameExtend\KFramework.MonoGameExtend.csproj" />
  </ItemGroup>

  <!-- 引擎的浏览器层（KFramework.TSEngine）目前由 tsconfig 固定输出到 MirGame/wwwroot/jsengine。
       这里把它同步过来即可，无需为每个游戏工程复制一份 TypeScript。 -->
  <!-- 编译引擎的浏览器层（TypeScript）。tsc 报错即中断构建，不留旧产物。 -->
  <!-- Debug 走 build（保留注释与 console，便于调试）；Release 走 build:release
       —— 在 tsc 之后补一步 terser：压缩 + 剥离所有 console.*（实现见 KFramework.TSEngine/minify.mjs）。 -->
  <Target Name="BuildTypeScript" BeforeTargets="BeforeBuild" Condition="Exists('$(MSBuildThisFileDirectory)..\KFramework.TSEngine\node_modules')">
    <PropertyGroup>
      <_TsBuildScript Condition="'$(Configuration)' == 'Release'">build:release</_TsBuildScript>
      <_TsBuildScript Condition="'$(_TsBuildScript)' == ''">build</_TsBuildScript>
    </PropertyGroup>
    <Exec Command="npm run $(_TsBuildScript)" WorkingDirectory="$(MSBuildThisFileDirectory)..\KFramework.TSEngine" />
  </Target>

  <!-- KFramework.TSEngine/dist/<配置>/jsengine 已是完整产物（含 deps/ktx2 转码器），
       直接整体复制到本工程 wwwroot/jsengine 即可。
       按 $(Configuration) 取：Debug 拿未压产物（带注释与 console），Release 拿压缩过的。 -->
  <Target Name="SyncJsEngine" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <_Engine Include="$(MSBuildThisFileDirectory)..\KFramework.TSEngine\dist\$(Configuration)\jsengine\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_Engine)" DestinationFiles="@(_Engine->'$(MSBuildThisFileDirectory)wwwroot\jsengine\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- 本工程独占的内容管线：Content/raw -> Content/content -> wwwroot/content
       （不共用 KFramework.Content 目录，避免和 MirGame 的素材混在一起） -->
  <Target Name="BuildGameContent" BeforeTargets="BeforeBuild">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\KFramework.Content.Cli\KFramework.Content.Cli.csproj&quot; -v q --nologo -- --root &quot;$(MSBuildThisFileDirectory)Content&quot;" ContinueOnError="true" />
    <ItemGroup>
      <_PublishedContent Include="$(MSBuildThisFileDirectory)Content\hot_update_res\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishedContent)" DestinationFiles="@(_PublishedContent->'$(MSBuildThisFileDirectory)wwwroot\hot_update_res\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>

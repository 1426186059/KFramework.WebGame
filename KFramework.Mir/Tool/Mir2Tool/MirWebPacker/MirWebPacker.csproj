<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MirWebPacker</RootNamespace>
    <AssemblyName>MirWebPacker</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
	  <Content Include="Properties\launchSettings.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图像处理复用 MirLib 的 SkiaSharp 能力（含无损 WebP） -->
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.152.0" />
    <ProjectReference Include="..\MirLib\MirLib.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mir2ReverseWeb</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 本应用不使用 jQuery，关闭 VS Browser Link 注入（避免 $.noConflict 报错） -->
    <DisableBrowserLink>true</DisableBrowserLink>
  </PropertyGroup>

  <ItemGroup>
    <!-- 图像处理统一使用 SkiaSharp，不再依赖 System.Drawing -->
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.152.0" />
  </ItemGroup>

</Project>

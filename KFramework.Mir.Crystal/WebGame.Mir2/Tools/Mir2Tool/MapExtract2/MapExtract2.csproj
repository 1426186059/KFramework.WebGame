<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MapExtract2</RootNamespace>
    <AssemblyName>MapExtract2</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MirLib\MirLib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="mapextract2.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
